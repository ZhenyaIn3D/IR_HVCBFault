  - infoPanelText: "\u2022 \u05E9\u05DC\u05D7\u05D5 \u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DE\u05E7\u05D5\u05DE\u05D9\u05EA \u05D3\u05E8\u05DA \u05DC\u05D5\u05D7
      POL<link=\"my_button_step_5\"><color=#00000000>|</color><rotate=45><sprite
      name=\"X Button\"></rotate><color=#00000000>|</color></link>\\n\\n \u2022 \u05D4\u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DC\u05D0 \u05E2\u05D1\u05E8\u05D4: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 \u2013 \u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05D2\u05E2\u05DF
      3MK.\\n\\n \u2022 \u05D1\u05DE\u05D9\u05D3\u05D4 \u05D5\u05D4\u05E4\u05E7\u05D5\u05D3\u05D4
      \u05E2\u05D1\u05E8\u05D4, \u05E7\u05D9\u05D9\u05DE\u05EA \u05D1\u05E2\u05D9\u05D4
      \u05D1\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D1\u05D9\u05DF ADACS \u05DC-
      POL, \u05E0\u05D3\u05E8\u05E9 \u05DC\u05E2\u05D3\u05DB\u05DF \u05D0\u05EA \u05DE\u05E4\u05E2\u05D9\u05DC
      ADACS."
    stepName: "\u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4 \u05DE\u05E7\u05D5\u05DE\u05D9\u05EA
      \u05DE\u05DC\u05D5\u05D7 POL"
