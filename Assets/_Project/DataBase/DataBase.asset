  - infoPanelText: "\u2022  \u05D1\u05E6\u05E2\u05D5 \u05D1\u05D3\u05D9\u05E7\u05D4
      \u05DE\u05DB\u05D0\u05E0\u05D9\u05EA \u05E9\u05DC \u05D4\u05DE\u05E0\u05D5\u05E2
      \u05DC\u05E4\u05D9 \u05D4\u05E9\u05DC\u05D1\u05D9\u05DD \u05D4\u05D1\u05D0\u05D9\u05DD:
      \\n  \u2022\u05D5\u05D9\u05D3\u05D5\u05D0 \u05DE\u05E6\u05D1 \u05DE\u05E4\u05EA\u05D7
      \u05DC\u05D0 \u05E0\u05E2\u05D5\u05DC\\n  \u2022\u05E0\u05D9\u05EA\u05D5\u05E7
      \u05D6\u05E8\u05D5\u05E2.\\n  \u2022\u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DE\u05DE\u05E8\u05DB\u05D6 \u05D1\u05E7\u05E8\u05D4.\\n  \u2022\u05D1\u05D3\u05D9\u05E7\u05EA
      \u05EA\u05E0\u05D5\u05E2\u05EA \u05DE\u05E0\u05D5\u05E2 \u05DC\u05DC\u05D0
      \u05E2\u05D5\u05DE\u05E1.\\n\u2022 \u05D4\u05DE\u05E0\u05D5\u05E2 \u05E4\u05D5\u05E2\u05DC
      \u05DC\u05DC\u05D0 \u05E2\u05D5\u05DE\u05E1 \u05D1\u05D0\u05D5\u05E4\u05DF
      \u05EA\u05E7\u05D9\u05DF: \u05E4\u05EA\u05E8\u05EA\u05DD \u05D0\u05EA \u05D4\u05EA\u05E7\u05DC\u05D4
      \u05D1\u05D4\u05E6\u05DC\u05D7\u05D4! "
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05DB\u05D0\u05E0\u05D9\u05EA
      \u05E9\u05DC \u05D4\u05DE\u05E0\u05D5\u05E2"
