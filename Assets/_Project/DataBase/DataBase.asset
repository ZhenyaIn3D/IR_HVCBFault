  steps:
  - infoPanelText: "\u05D4\u05D0\u05DD \u05D1\u05D4\u05EA\u05D0\u05DD \u05DC\u05D4\u05EA\u05E8\u05D0\u05D5\u05EA
      \u05E9\u05D4\u05EA\u05E7\u05D1\u05DC\u05D5 \u05D1\u05DE\u05E8\u05DB\u05D6 \u05D4\u05D1\u05E7\u05E8\u05D4
      \u05D4\u05E0\u05DB\u05DD \u05E0\u05D3\u05E8\u05E9\u05D9\u05DD \u05DC\u05D2\u05E9\u05EA
      \u05DC\u05D1\u05E6\u05E2 \u05D1\u05D3\u05D9\u05E7\u05D4 \u05D1UTR?"
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05D4 \u05D1UTR"
    infoVideoClip: {fileID: 32900000, guid: e3bf9284b87dc4fbe81280e684f20a84, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 0
  - infoPanelText: "\u2022 \u05D2\u05E9\u05D5 \u05DC\u05D0\u05E8\u05D5\u05DF UTR
      \u05D5\u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05EA\u05E7\u05D9\u05E0\u05D5\u05EA
      \u05D4\u05E8\u05D9\u05E0\u05D2 \u05D1\u05DE\u05E1\u05DA. \\n\u2022 \u05D4\u05E8\u05D9\u05E0\u05D2
      \u05EA\u05E7\u05D9\u05DF: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 \u2013 \u05D6\u05D9\u05D4\u05D5\u05D9 \u05D5\u05D0\u05EA\u05D7\u05D5\u05DC
      \u05D1\u05E7\u05E8 \u05E4\u05E2\u05D9\u05DC. \\n\u2022 \u05D4\u05E8\u05D9\u05E0\u05D2
      \u05DC\u05D0 \u05EA\u05E7\u05D9\u05DF: \u05DC\u05D7\u05E5 \u05DB\u05D0\u05DF
      \u05DC\u05DC\u05DE\u05D9\u05D3\u05D4 \u05E2\u05DC \u05E1\u05D9\u05D1\u05D5\u05EA
      \u05D0\u05E4\u05E9\u05E8\u05D9\u05D5\u05EA. "
    stepName: " \u05D1\u05D3\u05D9\u05E7\u05EA \u05E8\u05D9\u05E0\u05D2 \u05D1\u05D0\u05E8\u05D5\u05DF
      UTR"
    infoVideoClip: {fileID: 32900000, guid: aea358e5aa9de459fb889d2c5b6b0ae0, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022 \u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05DC\u05E9\u05D5\u05E0\u05D9\u05EA
      MOCSYS \u05D5\u05D6\u05D4\u05D5 \u05D0\u05EA \u05D4\u05E8\u05DB\u05D9\u05D1
      \u05D4\u05E4\u05E2\u05D9\u05DC (\u05D4\u05DB\u05EA\u05D5\u05DD), \u05E4\u05EA\u05D7\u05D5
      \u05D0\u05EA \u05D4\u05D0\u05E8\u05D5\u05DF \u05D5\u05D1\u05D3\u05E7\u05D5
      \u05D0\u05EA \u05EA\u05E7\u05D9\u05E0\u05D5\u05EA \u05D4\u05E8\u05DB\u05D9\u05D1 
      \\n\u2022 \u05D1\u05E6\u05E2\u05D5 \u05D0\u05D9\u05E4\u05D5\u05E1 \u05DC\u05D1\u05E7\u05E8
      \u05D4\u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9 \u05D5\u05E6\u05E8\u05D5 \u05E7\u05E9\u05E8
      \u05E2\u05DD \u05DE\u05E8\u05DB\u05D6 \u05D4\u05D1\u05E7\u05E8\u05D4.\\n\u2022 
      \u05D1\u05DE\u05D9\u05D3\u05D4 \u05D5\u05D0\u05D9\u05DF \u05EA\u05E7\u05E9\u05D5\u05E8\u05EA
      \u05D0\u05D7\u05E8\u05D9 \u05D0\u05D9\u05E4\u05D5\u05E1, \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5
      \u05DC\u05E9\u05DC\u05D1 \u05D4\u05D1\u05D0 "
    stepName: "\u05D0\u05EA\u05D7\u05D5\u05DC \u05D1\u05E7\u05E8 \u05E4\u05E2\u05D9\u05DC"
    infoVideoClip: {fileID: 32900000, guid: 7ee4be861c8b3414db2ae92281556be5, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022 \u05E6\u05E8\u05D5 \u05E7\u05E9\u05E8 \u05E2\u05DD \u05DE\u05E8\u05DB\u05D6
      \u05D4\u05D1\u05E7\u05E8\u05D4 \u05D5\u05D1\u05E7\u05E9\u05D5 \u05E9\u05DC\u05D9\u05D7\u05EA
      \u05E4\u05E7\u05D5\u05D3\u05D4 \u05DE\u05E8\u05D7\u05D5\u05E7. \\n\u2022 \u05D4\u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DC\u05D0 \u05E2\u05D1\u05E8\u05D4: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 \u2013 \u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DE\u05E7\u05D5\u05DE\u05D9\u05EA. \\n\u2022 \u05D1\u05DE\u05D9\u05D3\u05D4
      \u05D5\u05D4\u05E4\u05E7\u05D5\u05D3\u05D4 \u05E2\u05D1\u05E8\u05D4, \u05E7\u05D9\u05D9\u05DE\u05EA
      \u05D1\u05E2\u05D9\u05D4 \u05D1\u05E2\u05D9\u05D4 \u05D1\u05DE\u05E2\u05E8\u05DB\u05EA
      ADACS, \u05E0\u05D3\u05E8\u05E9 \u05DC\u05E2\u05D3\u05DB\u05DF \u05D0\u05EA
      \u05DE\u05E4\u05E2\u05D9\u05DC ADACS."
    stepName: "\u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4 \u05DE\u05E8\u05D7\u05D5\u05E7"
    infoVideoClip: {fileID: 32900000, guid: 8cb94ab2a317946f6ac5a7a5c59f04a8, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022 \u05E9\u05DC\u05D7\u05D5 \u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DE\u05E7\u05D5\u05DE\u05D9\u05EA \u05D3\u05E8\u05DA \u05DC\u05D5\u05D7
      POL \\n\u2022 \u05D4\u05E4\u05E7\u05D5\u05D3\u05D4 \u05DC\u05D0 \u05E2\u05D1\u05E8\u05D4:
      \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1 \u05D4\u05D1\u05D0 \u2013
      \u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05D2\u05E2\u05DF 3MK. \\n\u2022 \u05D1\u05DE\u05D9\u05D3\u05D4
      \u05D5\u05D4\u05E4\u05E7\u05D5\u05D3\u05D4 \u05E2\u05D1\u05E8\u05D4, \u05E7\u05D9\u05D9\u05DE\u05EA
      \u05D1\u05E2\u05D9\u05D4 \u05D1\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D1\u05D9\u05DF
      ADACS \u05DC- POL, \u05E0\u05D3\u05E8\u05E9 \u05DC\u05E2\u05D3\u05DB\u05DF
      \u05D0\u05EA \u05DE\u05E4\u05E2\u05D9\u05DC ADACS."
    stepName: "\u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4 \u05DE\u05E7\u05D5\u05DE\u05D9\u05EA
      \u05DE\u05DC\u05D5\u05D7 POL"
    infoVideoClip: {fileID: 32900000, guid: f51a1e0b4b2534c3b85cb068c3ca6001, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022  \u05E6\u05E8\u05D5 \u05E7\u05E9\u05E8 \u05E2\u05DD \u05DE\u05E8\u05DB\u05D6
      \u05D4\u05D1\u05E7\u05E8\u05D4 \u05DC\u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4
      \u05DC\u05DE\u05E0\u05EA\u05E7. \\n\u2022 \u05DE\u05D3\u05D3\u05D5 \u05DE\u05EA\u05D7
      \u05D1\u05DE\u05D2\u05E2\u05DF 3MK \u05D1\u05DE\u05E9\u05DA 01 \u05E9\u05E0\u05D9\u05D5\u05EA
      \u05D1\u05D6\u05DE\u05DF \u05E9\u05DC\u05D9\u05D7\u05EA \u05E4\u05E7\u05D5\u05D3\u05D4.
      \\n\u2022 \u05E0\u05DE\u05D3\u05D3 \u05DE\u05EA\u05D7 \u05EA\u05E7\u05D9\u05DF
      \u05E9\u05DC 022V CD: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1 \u05D4\u05D1\u05D0
      \u2013 \u05D1\u05D3\u05D9\u05E7\u05EA \u05D0\u05E8\u05D5\u05DF UCM. \\n\u2022
      \u05DC\u05D0 \u05E0\u05DE\u05D3\u05D3 \u05DE\u05EA\u05D7: \u05DC\u05D7\u05E5
      \u05DB\u05D0\u05DF \u05DC\u05E4\u05D9\u05E8\u05D5\u05D8 \u05D4\u05DE\u05E9\u05DA
      \u05E4\u05E2\u05D5\u05DC\u05D5\u05EA. \u05E7\u05D9\u05D9\u05DE\u05EA \u05D1\u05E2\u05D9\u05D4
      \u05D1\u05D0\u05E8\u05D5\u05DF RTU, \u05E0\u05D3\u05E8\u05E9 \u05DC\u05D1\u05E6\u05E2
      \u05D0\u05D9\u05EA\u05D5\u05E8 \u05EA\u05E7\u05DC\u05D5\u05EA \u05D1\u05D0\u05E8\u05D5\u05DF
      \u05D5\u05EA\u05D9\u05E7\u05D5\u05DF \u05D1\u05D4\u05EA\u05D0\u05DD. \u05D9\u05D9\u05EA\u05DB\u05DF
      \u05D5\u05E7\u05D9\u05D9\u05DE\u05EA \u05EA\u05E7\u05DC\u05D4 \u05D1\u05DE\u05D2\u05E2\u05DF
      \u05D0\u05D5 \u05D1\u05DB\u05D1\u05DC \u05DB\u05D5\u05D7. "
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05D2\u05E2\u05DF 3MK"
    infoVideoClip: {fileID: 32900000, guid: c387ea604d96e426cb719bce9ec8ce70, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022  \u05D2\u05E9\u05D5 \u05DC\u05D0\u05E8\u05D5\u05DF MCU
      \u05D5\u05E6\u05E8\u05D5 \u05E7\u05E9\u05E8 \u05E2\u05DD \u05DE\u05E4\u05E2\u05D9\u05DC
      SCADA  \u05D8\u05E8\u05DD \u05E4\u05EA\u05D9\u05D7\u05EA \u05D4\u05D0\u05E8\u05D5\u05DF.
      \\n\u2022 \u05D5\u05D3\u05D0\u05D5 \u05DE\u05D5\u05DC \u05DE\u05E4\u05E2\u05D9\u05DC
      SCADA  \u05E7\u05D1\u05DC\u05EA \u05D4\u05D5\u05D3\u05E2\u05EA \u05E4\u05EA\u05D9\u05D7\u05EA
      \u05D3\u05DC\u05EA. \\n\u2022  \u05DC\u05D0 \u05D4\u05EA\u05E7\u05D1\u05DC\u05D4
      \u05D4\u05D5\u05D3\u05E2\u05D4: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 \u2013 \u05D1\u05D3\u05D9\u05E7\u05EA KCARTC. \\n\u2022
      \u05D4\u05EA\u05E7\u05D1\u05DC\u05D4 \u05D4\u05D5\u05D3\u05E2\u05D4: \u05D4\u05DE\u05E9\u05DA
      \u05DC\u05E9\u05DC\u05D1 \u05D1\u05D3\u05D9\u05E7\u05EA \u05D4\u05D2\u05E0\u05EA
      \u05DE\u05E0\u05D5\u05E2.   "
    stepName: "\u05E4\u05EA\u05D9\u05D7\u05EA \u05D0\u05E8\u05D5\u05DF UCM"
    infoVideoClip: {fileID: 32900000, guid: f51a1e0b4b2534c3b85cb068c3ca6001, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022  \u05D5\u05D3\u05D0\u05D5 \u05DE\u05EA\u05D2 2Q \u05DE\u05D5\u05E8\u05DD
      \u05D5\u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D5\u05D5\u05D9
      \u05E9\u05DC \u05D1\u05E7\u05E8 KCARTC.  \\n\u2022 \u05E0\u05D5\u05E8\u05D9\u05EA
      \u05D0\u05D3\u05D5\u05DE\u05D4: \u05E7\u05D9\u05D9\u05DE\u05EA \u05D1\u05E2\u05D9\u05D4
      \u05D1\u05D1\u05E7\u05E8.\u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 \u2013 \u05D1\u05D3\u05D9\u05E7\u05EA \u05E1\u05D9\u05D1
      \u05D0\u05D5\u05E4\u05D8\u05D9. \\n\u2022 \u05E0\u05D5\u05E8\u05D9\u05EA \u05D9\u05E8\u05D5\u05E7\u05D4/\u05E6\u05D4\u05D5\u05D1\u05D4:
      \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1 \u05D1\u05D3\u05D9\u05E7\u05EA
      \u05D4\u05D2\u05E0\u05EA \u05DE\u05E0\u05D5\u05E2."
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05D1\u05E7\u05E8 KCARTC "
    infoVideoClip: {fileID: 32900000, guid: bc52de5308f2842e4afa83a36d1e344e, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022  \u05D1\u05D3\u05E7\u05D5 \u05E1\u05D9\u05D1 \u05D0\u05D5\u05E4\u05D8\u05D9.
      \\n\u2022 \u05E1\u05D9\u05D1 \u05D0\u05D5\u05E4\u05D8\u05D9 \u05E9\u05DC\u05DD
      \u05D5\u05EA\u05E7\u05D9\u05DF: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 - \u05D1\u05D3\u05D9\u05E7\u05EA \u05D4\u05D2\u05E0\u05EA
      \u05DE\u05E0\u05D5\u05E2. \\n\u2022 \u05E1\u05D9\u05D1 \u05D0\u05D5\u05E4\u05D8\u05D9
      \u05E4\u05D2\u05D5\u05DD: \u05E0\u05D3\u05E8\u05E9\u05EA \u05D4\u05D7\u05DC\u05E4\u05EA
      \u05E1\u05D9\u05D1 \u05D0\u05D5\u05E4\u05D8\u05D9."
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05E1\u05D9\u05D1 \u05D0\u05D5\u05E4\u05D8\u05D9"
    infoVideoClip: {fileID: 32900000, guid: 0e18b7875709c40ceb2ebaf4ddf6035c, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022  \u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05DE\u05E6\u05D1
      \u05D4\u05D2\u05E0\u05EA \u05D4\u05DE\u05E0\u05D5\u05E2 1Q (\u05DC\u05D7\u05E6\u05DF
      \u05E9\u05D7\u05D5\u05E8 \u05DC\u05D7\u05D5\u05E5). \\n\u2022  \u05E0\u05D5\u05E8\u05D9\u05EA
      START \u05D3\u05D5\u05DC\u05E7\u05EA: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1
      \u05D4\u05D1\u05D0 - \u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05EA\u05D7\u05D9\u05DD.
      \\n\u2022  \u05E0\u05D5\u05E8\u05D9\u05EA START \u05DB\u05D1\u05D5\u05D9\u05D4:
      \u05E0\u05D3\u05E8\u05E9\u05EA \u05D4\u05D7\u05DC\u05E4\u05EA \u05E8\u05DB\u05D9\u05D1
      1Q."
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05D4\u05D2\u05E0\u05EA \u05DE\u05E0\u05D5\u05E2
      1Q"
    infoVideoClip: {fileID: 32900000, guid: 5af2157570bbd4d848610fb3fc9b1548, type: 3}
    infoSprite: {fileID: 0}
    userInputType: 1
  - infoPanelText: "\u2022  \u05D1\u05D3\u05E7\u05D5 \u05DE\u05EA\u05D7\u05D9\u05DD
      \u05D1\u05D2\u05D9\u05D3\u05D9 \u05EA\u05E7\u05E9\u05D5\u05E8\u05EA. \\n\u2022
      \u05E6\u05E8\u05D5 \u05E7\u05E9\u05E8 \u05E2\u05DD \u05DE\u05E8\u05DB\u05D6
      \u05D4\u05D1\u05E7\u05E8\u05D4 \u05D5\u05DE\u05D3\u05D3\u05D5 \u05DE\u05EA\u05D7\u05D9\u05DD
      \u05D1\u05D2\u05D9\u05D3\u05D9 \u05DB\u05D5\u05D7 \u05D1\u05DE\u05E9\u05DA
      10 \u05E9\u05E0\u05D9\u05D5\u05EA \u05D1\u05D6\u05DE\u05DF \u05E9\u05DC\u05D9\u05D7\u05EA
      \u05E4\u05E7\u05D5\u05D3\u05EA. \\n\u2022 \u05DC\u05D0 \u05E0\u05DE\u05D3\u05D3
      \u05DE\u05EA\u05D7: \u05D4\u05DE\u05E9\u05DA \u05DC\u05E9\u05DC\u05D1 \u05D4\u05D1\u05D0
      \u2013 \u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05D2\u05E2\u05D9\u05DD."
    stepName: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05DE\u05EA\u05D7\u05D9\u05DD"
    infoVideoClip: {fileID: 32900000, guid: f51a1e0b4b2534c3b85cb068c3ca6001, type: 3}
